# Copy to .env for local use. Never commit .env. None of these start with VITE_ on purpose.
# Local dev works with no values: it uses a local embedded database and a random JWT secret.

# Postgres connection string (required in production, e.g. from Neon)
DATABASE_URL=
# Random string, 32+ characters (required in production). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Optional: your site's origin, e.g. https://skills-swap-final-mvp.vercel.app (CSRF origin check)
ALLOWED_ORIGIN=
